# 复制成 .env 后按需修改（npm start 不会自动读取 .env，可以用 `node --env-file=.env ...` 或在 shell / 容器里设置）

# 监听地址与端口
PORT=3000
HOST=0.0.0.0

# 数据目录：SQLite 数据库与会话密钥放在这里
DATA_DIR=./data

# 管理员账号。不设密码时每次启动会生成一个临时密码打印在日志里
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 会话签名密钥。不设时自动生成并保存在 DATA_DIR/session-secret
SESSION_SECRET=

# 部署在反向代理后面时设为 1，信任 X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=

# 调度器多少秒检查一次有没有到期的模型
SCHEDULER_TICK_SECONDS=15

# 请求上游时走 HTTP 代理
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
