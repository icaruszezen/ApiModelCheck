# 复制成 .env 后按需修改（npm start 不会自动读取 .env，可以用 `node --env-file=.env ...` 或在 shell / 容器里设置）
# 用 docker compose 时，compose 会读取同目录的 .env，但只用到其中的 ADMIN_PASSWORD（必填）

# 监听地址与端口
PORT=3000
HOST=0.0.0.0

# 数据目录：SQLite 数据库与会话密钥放在这里
DATA_DIR=./data

# 管理员账号。不设密码时每次启动会生成一个临时密码打印在日志里（docker compose 必须设置）。
# 请用至少 8 个字符的密码，比如用 `openssl rand -base64 18` 随机生成一个；
# 太短、或是 change-me 这类示例里的占位密码时，启动日志会打印警告
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 会话签名密钥。不设时自动生成并保存在 DATA_DIR/session-secret
SESSION_SECRET=

# 信任的反向代理层数：不设或 0 = 不信任；部署在一层反向代理（Nginx / Caddy）后面时设为 1。
# 设了以后客户端 IP 取 X-Forwarded-For 从右往左数第 N 个，并信任 X-Forwarded-Proto / X-Forwarded-Host。
# 只在本服务的端口不能被外网直接访问时设置（HOST=127.0.0.1，或 Docker 端口映射成 127.0.0.1:3000:3000），
# 否则别人可以绕过代理直接连上来伪造这些头
TRUST_PROXY=

# 调度器多少秒检查一次有没有到期的模型
SCHEDULER_TICK_SECONDS=15

# 请求上游时走 HTTP 代理
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
